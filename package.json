{
  "name": "classicwowforever",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write .",
    "test:db": "bash scripts/test-db.sh",
    "db:start": "npx -y supabase@latest start",
    "db:stop": "npx -y supabase@latest stop",
    "db:reset": "npx -y supabase@latest db reset",
    "db:env": "bash scripts/local-env.sh",
    "schema:export": "UPDATE_SCHEMA=1 vitest run lib/prompts/planOutputSchema.test.ts",
    "evals": "cd evals && .venv/bin/python run_evals.py",
    "evals:setup": "python3 -m venv evals/.venv && evals/.venv/bin/pip install -q -r evals/requirements.txt"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.24.0"
}
