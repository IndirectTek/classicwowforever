# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings > API Keys.
# New projects issue "publishable" (sb_publishable_...) and "secret" (sb_secret_...)
# keys. The legacy anon and service_role keys also work in these slots.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Milestone 3 (planner)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
FREE_PLANS_PER_WEEK=3
