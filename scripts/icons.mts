// Copies the icons the site uses out of @iconify-json/game-icons into
// components/icons/gameIcons.ts, so pages ship only these few paths and not
// all 4,000 icons.
//
//   pnpm icons
//
// To add an icon: find it on https://game-icons.net, add its name and artist
// below (the artist is the folder it lives in on
// https://github.com/game-icons/icons), run `pnpm icons`, then use it through
// lib/icons.ts. Every icon is CC BY 3.0 and credited on /open-source.
import { readFileSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { join } from "node:path";
import { format, resolveConfig } from "prettier";

const ROOT = join(import.meta.dirname, "..");
const OUT = join(ROOT, "components/icons/gameIcons.ts");

// The artists' names as game-icons.net credits them.
const ARTISTS = {
  lorc: { name: "Lorc", url: "https://lorcblog.blogspot.com" },
  delapouite: { name: "Delapouite", url: "https://delapouite.com" },
  skoll: { name: "Skoll", url: "https://game-icons.net" },
  zeromancer: { name: "Zeromancer", url: "https://game-icons.net" },
} as const;
type Artist = keyof typeof ARTISTS;

const ICONS: Record<string, Artist> = {
  // Roles
  "templar-shield": "delapouite",
  "heart-plus": "zeromancer",
  "crossed-swords": "lorc",
  // Goals
  upgrade: "delapouite",
  "two-coins": "delapouite",
  breastplate: "lorc",
  "dungeon-gate": "delapouite",
  campfire: "lorc",
  // Classes
  "battle-axe": "lorc",
  warhammer: "delapouite",
  "high-shot": "lorc",
  hood: "lorc",
  "angel-wings": "lorc",
  totem: "delapouite",
  "pointy-hat": "lorc",
  "burning-skull": "skoll",
  paw: "lorc",
  // Home page, plans and reports
  hourglass: "lorc",
  "scroll-unfurled": "lorc",
  "beer-stein": "lorc",
  "spell-book": "delapouite",
  "night-sleep": "delapouite",
  "quill-ink": "lorc",
  compass: "lorc",
};

const require = createRequire(import.meta.url);
const pack = require("@iconify-json/game-icons/icons.json") as {
  icons: Record<string, { body: string }>;
};
const packVersion = JSON.parse(
  readFileSync(require.resolve("@iconify-json/game-icons/package.json"), "utf8"),
).version;

const entries = Object.entries(ICONS).map(([name, artist]) => {
  const body = pack.icons[name]?.body;
  if (!body) throw new Error(`No icon named "${name}" in @iconify-json/game-icons`);
  // Every icon we use is plain paths; anything else would need a closer look.
  const paths = [...body.matchAll(/<path fill="currentColor" d="([^"]+)"\/>/g)].map((m) => m[1]);
  if (!paths.length || body.replace(/<path fill="currentColor" d="[^"]+"\/>/g, "")) {
    throw new Error(`"${name}" isn't plain paths; check it by hand`);
  }
  return { name, artist, paths };
});

const source = `// GENERATED by \`pnpm icons\` (scripts/icons.mts) from
// @iconify-json/game-icons ${packVersion}. Do not edit by hand.
//
// Icons from https://game-icons.net, CC BY 3.0
// (https://creativecommons.org/licenses/by/3.0/). Credited on /open-source.

export const gameIcons = {
${entries.map((e) => `  ${JSON.stringify(e.name)}: ${JSON.stringify(e.paths)},`).join("\n")}
} as const;

export type GameIconName = keyof typeof gameIcons;

export const iconArtists = ${JSON.stringify(ARTISTS, null, 2)} as const;

export const iconCredits: Record<GameIconName, keyof typeof iconArtists> = {
${entries.map((e) => `  ${JSON.stringify(e.name)}: ${JSON.stringify(e.artist)},`).join("\n")}
};
`;

const options = (await resolveConfig(OUT)) ?? {};
writeFileSync(OUT, await format(source, { ...options, filepath: OUT }));
console.log(`Wrote ${entries.length} icons to components/icons/gameIcons.ts`);
